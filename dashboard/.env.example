# The FastAPI backend this dashboard reads from.
#
# NEXT_PUBLIC_ variables are inlined at build time, so this must be set as a *build*
# variable in Vercel, not only at runtime — changing it means a redeploy.
#
# Local:  leave unset; it falls back to http://127.0.0.1:8000
# Vercel: the Railway URL of the API service, no trailing slash.
NEXT_PUBLIC_API_BASE=https://your-api.up.railway.app
