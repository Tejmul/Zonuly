# Never bake these into an image: secrets, the live database, local envs, caches.
.env
.env.*
secrets/
jobhunter.db
jobhunter.db-*
*.sqlite*

.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# The dashboard is deployed separately (Vercel); not part of this image.
dashboard/

# The source scrape the landing page was cut from: 48 MB of build context that the
# image never copies. demo.db is deliberately NOT ignored — the API serves it.
assets/

.git/
.github/
.claude/
.DS_Store
*.log

# Design documents and generated views are not runtime inputs.
system docs/
knowledge/graph.html
knowledge/BRIEF.md
